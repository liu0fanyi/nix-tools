# Local secret exports and KeePassXC databases; never commit.
git-crypt-key
nix-tools-git-crypt.key
*.kdbx

# Nix result symlinks
result
result-*

# Local nix eval cache (used when sandbox blocks ~/.cache/nix)
.nix-cache/
.nix-data/
.nix-runtime/
.nix-state/

# devenv (local shell state and sandbox-verification direnv config)
.devenv/
.direnv-config/

# Generated deployment artifacts, legacy in-repository backups, and runtime secrets
deploy/.generated/
deploy/backups/
__pycache__/
*.py[cod]

# VPS bind-mounted runtime data
/caddy-config/
/caddy-data/
/dist/
/dufs_data/
/migration-backups/
/tag-db/

# Official reference clones for diffing (never committed)
.official-reference/

# Local npm cache
.npm-cache/
