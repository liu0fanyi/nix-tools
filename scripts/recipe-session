#!/usr/bin/env bash
set -euo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
runtime=$(nix build --impure --no-link --print-out-paths --file "$repo/packages/subtitle-ocr-runtime.nix")
export PATH="$runtime/bin:$PATH"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/nix-tools/recipe-library"
mkdir -p "$cache"
key=$(cat "$repo/scripts/recipe-library-requirements.txt" <(printf '%s' "$runtime") | sha256sum | cut -c1-16)
venv="$cache/env-$key"
export UV_CACHE_DIR="$cache/uv"
(
  flock 9
  if [[ ! -f "$venv/.ready" ]]; then
    uv venv --allow-existing --python "$runtime/bin/python3.12" "$venv"
    # All validation/image dependencies are pinned; this does not install a model.
    uv pip install --python "$venv/bin/python" --no-deps -r "$repo/scripts/recipe-library-requirements.txt"
    touch "$venv/.ready"
  fi
) 9>"$cache/setup.lock"
exec "$runtime/bin/ocr-run" "$venv/bin/python" "$repo/scripts/recipe-session.py" "$@"
