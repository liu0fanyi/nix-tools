{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video recipe internal contract v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "recipe_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "video_id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transcript_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "subtitle_origin": {
          "enum": [
            "platform",
            "ocr",
            "asr"
          ]
        }
      },
      "required": [
        "platform",
        "video_id",
        "url",
        "author",
        "duration_seconds",
        "transcript_sha256",
        "subtitle_origin"
      ]
    },
    "coverage": {
      "enum": [
        "full",
        "partial"
      ]
    },
    "covered_intervals": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/interval"
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "draft",
        "needs_review",
        "ready"
      ]
    },
    "human_reviewed": {
      "type": "boolean"
    },
    "ingredients": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ingredient"
      },
      "minItems": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    },
    "variants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/variant"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 1
    },
    "frames": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/frame"
      },
      "minItems": 0
    },
    "image_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/image_review"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "recipe_id",
    "title",
    "source",
    "coverage",
    "covered_intervals",
    "status",
    "human_reviewed",
    "ingredients",
    "steps",
    "variants",
    "evidence",
    "frames",
    "image_reviews",
    "issues",
    "runs"
  ],
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "exact",
            "approximate",
            "range",
            "unspecified"
          ]
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "original": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "mode",
        "min",
        "max",
        "unit",
        "original"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "subtitle",
            "frame",
            "audio"
          ]
        },
        "interval": {
          "$ref": "#/$defs/interval"
        },
        "cue_ids": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 0
        },
        "frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        },
        "observation": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "interval",
        "cue_ids",
        "frame_id",
        "quote",
        "observation"
      ]
    },
    "ingredient": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "main",
            "seasoning",
            "optional"
          ]
        },
        "quantity": {
          "$ref": "#/$defs/quantity"
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 1
        },
        "review_status": {
          "enum": [
            "supported",
            "needs_review"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "quantity",
        "evidence_ids",
        "review_status"
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "action",
            "duration",
            "heat",
            "cut_size",
            "endpoint",
            "order",
            "tip"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "measure": {
          "anyOf": [
            {
              "$ref": "#/$defs/quantity"
            },
            {
              "type": "null"
            }
          ]
        },
        "ingredient_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 0
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 1
        },
        "review_status": {
          "enum": [
            "supported",
            "needs_review"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "text",
        "measure",
        "ingredient_ids",
        "evidence_ids",
        "review_status"
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 0
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 1
        },
        "evidence_windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/interval"
          },
          "minItems": 1
        },
        "image_goal": {
          "type": "string",
          "minLength": 1
        },
        "selected_frame_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "no_image_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "depends_on",
        "facts",
        "evidence_windows",
        "image_goal",
        "selected_frame_id",
        "no_image_reason"
      ]
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "replaces_ingredient_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 0
        },
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "name",
        "replaces_ingredient_ids",
        "facts"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "file": {
          "type": "string",
          "pattern": "^images/[A-Za-z0-9_-]+\\.(jpg|png|webp)$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestamp": {
          "type": "number",
          "minimum": 0
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "file",
        "sha256",
        "timestamp",
        "width",
        "height"
      ]
    },
    "image_review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "frame_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "relevance": {
          "enum": [
            "matches",
            "uncertain",
            "mismatch"
          ]
        },
        "quality": {
          "enum": [
            "usable",
            "blurred",
            "occluded",
            "too_small"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "step_id",
        "frame_id",
        "relevance",
        "quality",
        "reason"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "code": {
          "enum": [
            "quantity_unclear",
            "ocr_ambiguous",
            "source_conflict",
            "missing_evidence",
            "missing_image",
            "incomplete_coverage",
            "other"
          ]
        },
        "target_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "minItems": 0
        },
        "resolution": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution_note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "code",
        "target_ids",
        "description",
        "evidence_ids",
        "resolution",
        "resolution_note"
      ]
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "extract",
            "review",
            "select_images",
            "render"
          ]
        },
        "processor": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "stage",
        "processor",
        "model",
        "prompt_version",
        "input_sha256"
      ]
    }
  }
}
